# ── Turumba configuration ─────────────────────────────────────────────────────
# Copy to .env and fill in. Everything works in DRY-RUN with no secrets set.

# Which marketplaces the secondhand MCP should enable (comma-separated).
# facebook needs no auth. ebay needs keys. depop/poshmark need Chrome installed.
MARKETPLACES=facebook

# ── Email delivery ────────────────────────────────────────────────────────────
# Leave SMTP_* blank to run in dry-run mode: digests render to ./out/*.html
# instead of being sent. Fill these in to actually send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From: address and display name subscribers see.
MAIL_FROM_NAME=Turumba
MAIL_FROM_EMAIL=hello@turumba.family

# ── Web app ───────────────────────────────────────────────────────────────────
PORT=4310
# Public base URL used to build unsubscribe links in emails.
PUBLIC_BASE_URL=http://localhost:4310
